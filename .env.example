# The ADX backend the site talks to — the same one the apps and the console use.
# Production: https://adx-backendv1.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Where this site is served from, for links it writes about itself (QR landings, share links).
NEXT_PUBLIC_SITE_URL=http://localhost:5174

# Google sign-in on the web: the same OAuth web client id the backend verifies (GOOGLE_CLIENT_ID there). Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook sign-in on the web (FB-1): the Facebook app id whose access tokens the backend verifies (FACEBOOK_APP_ID / FACEBOOK_APP_SECRET there). Leave empty to keep the button disabled.
NEXT_PUBLIC_FACEBOOK_APP_ID=

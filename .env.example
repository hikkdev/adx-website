# ADX website (adx.in) — every name the code reads. Copy to .env (or .env.local)
# and fill in; secrets never go here (the site holds none: every value is public).
# Next.js bakes every NEXT_PUBLIC_* value into the build: on Render set them
# BEFORE the build (render.yaml lists them), and rebuild after changing one.
# Production values and the names that must match another app's:
# PRODUCTION-ENV.md at the monorepo root. `node scripts/env-audit.mjs` (from
# the monorepo root) compares your env file with this one by NAME only.

# The ADX backend the site talks to — the same one the apps and the console use.
# Required in production. Must be the backend's BASE_URL + /api/v1, the same
# value as the console's NEXT_PUBLIC_API_BASE_URL and the apps' RELEASE_API_BASE_URL.
# Production: https://adx-backendv1.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Where this site is served from, for links it writes about itself (QR landings,
# share links, sitemap, robots, page metadata). Required in production
# (https://adx.in). Same value as the console's NEXT_PUBLIC_SITE_URL and the
# backend's PUBLIC_WEB_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:5174

# The admin console, for Studio's "Open Studio from the console" door (Studio is
# opened from Content > Pages there). The console's dev PORT is in its own .env.
# Required in production once the console is deployed: the console's address,
# the same value as the backend's FRONTEND_URL.
NEXT_PUBLIC_CONSOLE_URL=http://localhost:5173

# Google sign-in on the web: the same OAuth web client id the backend verifies
# (GOOGLE_CLIENT_ID there, and the console's NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# Optional: leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook sign-in on the web (FB-1): the Facebook app id whose access tokens the
# backend verifies (FACEBOOK_APP_ID / FACEBOOK_APP_SECRET there; the apps build
# with the same FACEBOOK_APP_ID). Optional: leave empty to keep the button disabled.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Not read from this file: `npm run pages` (build-pages.mjs) is plain Node and
# takes the backend it reads published pages from as a SHELL variable or flag —
#   ADX_API_URL=https://adx-backendv1.onrender.com/api/v1 npm run pages
#   npm run pages -- --api http://localhost:3000/api/v1
# Unset, it reads the Render backend.
# ADX_API_URL=
